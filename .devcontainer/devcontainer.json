{
  "name": "publira website",
  "image": "ghcr.io/publira/base-images/publira-dev:2026.10.31@sha256:9251c1199b350a3cb8cb7c696d585461e20cb72eaa6bc88fd457761d86b5c7f0",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "mounts": [
    "source=publira-website-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=publira-website-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=publira-website-gemini-${devcontainerId},target=/home/vscode/.gemini,type=volume",
    "source=publira-website-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=publira-website-grok-${devcontainerId},target=/home/vscode/.grok,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode",
        "TypeScriptTeam.native-preview"
      ]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
